{
  "name": "hono-backend-starter",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.4",
  "engines": { "bun": ">=1.4.4" },
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "start": "bun src/index.ts",
    "build": "bun build --target=bun --packages=external --outfile=dist/index.js src/index.ts",
    "start:prod": "APP_ENV=production bun --no-env-file dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "bun test tests/unit",
    "test:integration": "bun test tests/integration",
    "db:generate": "bun --bun drizzle-kit generate",
    "db:migrate": "bun --bun drizzle-kit migrate",
    "db:studio": "bun --bun drizzle-kit studio"
  },
  "dependencies": {
    "@hono/zod-validator": "0.9.1",
    "drizzle-orm": "0.45.4",
    "hono": "4.13.20",
    "pino": "10.4.0",
    "postgres": "4.1.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/bun": "1.4.4",
    "drizzle-kit": "0.31.11",
    "pino-pretty": "13.2.0",
    "typescript": "5.9.3"
  }
}
